def fix_title(filepath, new_title):
    with open(filepath, "r", encoding="utf-8") as f:
        content = f.read()

    original = content

    Remplacer le title existant
    content = re.sub(
        r'<title>.*?</title>',
        f'<title>{new_title}</title>',
        content,
        flags=re.DOTALL
    )

    if content != original:
        with open(filepath, "w", encoding="utf-8") as f:
            f.write(content)
        length = len(new_title)
        print(f"  ✅ ({length} car.) {filepath}")
        return True
    else:
        print(f"  ⏭️  SKIP (title non trouvé) {filepath}")
        return False

def main():
    print("=" * 55)
    print("CORRECTION DES TITLES - Synaptika.net")
    print("=" * 55)

    modified = 0
    errors = 0

    for rel_path, new_title in TITLES.items():
        filepath = os.path.join(BASE_DIR, rel_path)
        length = len(new_title)

        if length > 60:
            print(f"  🔴 TROP LONG ({length} car.) : {new_title}")
            errors += 1
            continue

        if not os.path.exists(filepath):
            print(f"  🔴 FICHIER INTROUVABLE : {filepath}")
            errors += 1
            continue

        result = fix_title(filepath, new_title)
        if result:
            modified += 1

    print("\n" + "=" * 55)
    print(f"  ✅ Fichiers modifiés  : {modified}")
    print(f"  🔴 Erreurs           : {errors}")
    print("\n🚀 Prochaine étape :")
    print("  git add .")
    print('  git commit -m "fix(seo): correction 47 balises title"')
    print("  git push origin main")
    print("=" * 55)

if __name__ == "__main__":
    main()
